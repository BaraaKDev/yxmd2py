      <Properties>
        <Configuration>
          <Passwords />
          <File OutputFileName="" RecordLimit="" SearchSubDirs="False" FileFormat="0">C:\data\orders.csv</File>
          <FormatSpecificOptions>
            <HeaderRow>True</HeaderRow>

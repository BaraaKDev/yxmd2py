    <Node ToolID="2">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="174" y="54" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="[Quantity] * [UnitPrice]" field="LineTotal" size="8" type="Double" />
            <FormulaField expression="IIF([LineTotal] &gt; 5000, &quot;High&quot;, IIF([LineTotal] &gt; 1000, &quot;Medium&quot;, &quot;Low&quot;))" field="ValueBand" size="16" type="V_String" />
            <FormulaField expression="Uppercase(Trim([CustomerName]))" field="CustomerName" size="128" type="V_String" />
            <FormulaField expression="DateTimeAdd([OrderDate], 30, &quot;days&quot;)" field="DueDate" size="8" type="Date" />
            <FormulaField expression="IF IsNull([DiscountPct]) THEN 0 ELSE ToNumber([DiscountPct]) ENDIF" field="DiscountPct" size="8" type="Double" />
            <FormulaField expression="Contains([ProductCode], &quot;-EU&quot;)" field="IsEuropean" size="1" type="Bool" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>LineTotal, ValueBand, DueDate...</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>
